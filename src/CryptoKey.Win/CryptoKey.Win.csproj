<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- GUI subsystem: no console is ever allocated, so there's no window
         to flash then hide. CLI verbs re-attach to the parent's console
         on demand (Program.AttachCliConsole). -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>cryptokey</AssemblyName>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);WFO5001;WFO1000</NoWarn>
    <!-- Lets CI/dev machines on macOS/Linux compile the Windows host (tests only need Core). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.9.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CryptoKey.Tests" />
    <ProjectReference Include="..\CryptoKey.Core\CryptoKey.Core.csproj" />
    <ProjectReference Include="..\CryptoKey.Ui\CryptoKey.Ui.csproj" />
    <!-- Avalonia backend for the shared UI: Win32 windowing + Skia rendering
         (not Avalonia.Desktop, which would also ship X11/macOS natives). -->
    <PackageReference Include="Avalonia.Win32" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
    <PackageReference Include="DokanNet" Version="2.3.0.3" />
    <PackageReference Include="FlashCap" Version="1.12.0" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

</Project>