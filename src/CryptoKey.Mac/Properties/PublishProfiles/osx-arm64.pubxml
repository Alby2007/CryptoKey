<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Folder publish: SkiaSharp/AvaloniaNative dylibs can't self-extract
         from a single file, so the payload is the directory — install
         copies the whole thing into ~/Applications/CryptoKey. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>bin\Publish\osx-arm64</PublishDir>
  </PropertyGroup>
</Project>
