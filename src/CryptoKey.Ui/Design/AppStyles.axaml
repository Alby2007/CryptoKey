<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CryptoKey.Ui.AppStyles">

  <!--
       CryptoKey "hardware key" design system. Every color/size resolves
       through resources installed from DesignTokens (Palette.Install).
       -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Brush.Carbon}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="TextBlock.hero">
    <Setter Property="FontSize" Value="44" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="19" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.6" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Paused}" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Locked}" />
  </Style>
  <Style Selector="TextBlock.ok">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Armed}" />
  </Style>
  <Style Selector="TextBlock.signal">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Signal}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.RaisedHigh}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HairlineHi}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Brush.Signal}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.CarbonDeep}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SignalHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.CarbonDeep}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SignalPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.CarbonDeep}" />
  </Style>

  <Style Selector="Button.lock">
    <Setter Property="Background" Value="{DynamicResource Brush.Locked}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.lock:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FF5A70" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Brush.LockedSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Locked}" />
    <Setter Property="BorderBrush" Value="#55FF3D57" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3AFF3D57" />
    <Setter Property="Foreground" Value="#FF7085" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Locked}" />
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Sidebar navigation -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
  </Style>
  <Style Selector="Button.nav:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- Segmented control segments -->
  <Style Selector="Button.segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.segment.active">
    <Setter Property="Background" Value="{DynamicResource Brush.RaisedHigh}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Signal}" />
  </Style>
  <Style Selector="Button.segment.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.RaisedHigh}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Signal}" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Brush.RaisedHigh}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HairlineHi}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Signal}" />
  </Style>
  <Style Selector="TextBox.error /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Locked}" />
  </Style>
  <Style Selector="TextBox.phrase">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="MinWidth" Value="96" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.well">
    <Setter Property="Background" Value="{DynamicResource Brush.CarbonDeep}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Hairline}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Brush.RaisedHigh}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HairlineHi}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
</Styles>
